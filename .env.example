# 抄呢個檔做 .env，填好之後行 `npm run setup` 就會自動裝好晒。
# .env 已經喺 .gitignore，唔會俾 git 上載。

# ── Cloudflare ──────────────────────────────────────────────
# dash.cloudflare.com → 右上角頭像 → My Profile → API Tokens → Create Token
# → 用「Edit Cloudflare Workers」模板，再喺 Permissions 加多一行：Account / D1 / Edit
CLOUDFLARE_API_TOKEN=

# ── Telegram ────────────────────────────────────────────────
# 同 @BotFather 講 /newbot 攞 token；同 @userinfobot 講嘢攞你嘅數字 id
# 攞完記得去自己個 bot 度撳一次「Start」，唔係佢send唔到嘢畀你
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Notion ──────────────────────────────────────────────────
# notion.so/my-integrations → New integration → 抄 Internal Integration Secret
NOTION_TOKEN=
# 喺 Notion 建一個空白 page（例如叫「個人助理」），page 右上角 ⋯ → Connections → 連接你個 integration，
# 然後將 page 條 URL 貼喺度。安裝腳本會自動喺呢個 page 下面建齊四個 database
NOTION_PARENT_PAGE=

# ── Anthropic ───────────────────────────────────────────────
# console.anthropic.com → API Keys（記得先充值，最低 US$5，正常用一年都用唔晒）
ANTHROPIC_API_KEY=

# ── 個人設定 ────────────────────────────────────────────────
# 你所在時區（IANA 格式）同晨早簡報時間（0-23）。搬咗去第二度改呢度再行多次 npm run setup 就得
TIMEZONE=Asia/Hong_Kong
BRIEF_HOUR=8

# ── 進階（唔填就用預設）─────────────────────────────────────
# Worker 同資料庫名。想同時裝多過一份（例如試新嘢）就改呢兩個名
# WORKER_NAME=personal-assistant
# D1_NAME=assistant-db

# CAPTURE_TOKEN 唔使填，安裝腳本會自動生成再寫返入呢個檔
